                "additionalProperties": false
              },
              "projectile_scale": {
                "type": "number"
              },
              "shows_status": {
                "type": "boolean",
                "$comment": "HUD shows its live status/charges (CastingReference)."
              },
              "shows_lasting": {
                "type": "boolean",
                "$comment": "Build summary shows how long it lasts."
              }
            },
            "additionalProperties": false
          },
          "rank_damage_pct": {
            "type": "number",
            "$comment": "Magic Missile: damage gained per rank as a fraction of its base."
          }
