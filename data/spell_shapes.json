  "mana_bolt": {
   "root": "missile",
   "parts": {
    "missile": {
     "delivery": "projectile",
     "origin": "caster",
     "geometry": {
      "type": "body",
      "radius": "=BOLT_RADIUS * float(v(\"projectile_size_multiplier\", 1.0))",
      "pad": "hurtbox"
     },
     "motion": [
      {
       "type": "guided",
       "speed": "=float(v(\"speed\", 450.0)) * speed",
       "lerp": "=float(v(\"homing_strength\", 6.0))",
       "range": "=float(v(\"speed\", 450.0)) * speed * 3.0"
      }
     ],
     "payload": [
      {
       "$damage": ""
      }
     ],
     "limits": {
      "pierce": 0,
      "contact_all": true
     },
     "vfx": {
      "family": "dart"
     }
    }
   },
   "arrangement": {
    "type": "single",
    "count": "=maxi(1, int(v(\"projectile_count\", 1)))"
   },
   "release": {
    "type": "staggered",
    "interval": 0.05,
    "retarget": true
   },
   "needs_target": true,
   "cast_rules": {
    "targeting": {
     "rule": "select"
    }
   }
  },
  "ember_spear": {
   "root": "spear",
