      {
       "$damage": "spear"
      }
     ],
     "limits": {
      "pierce": -1
     },
     "vfx": {
      "family": "spear"
     },
     "trail": {
      "$when": "bool(v(\"burn_trail\", false))",
      "part": "trail"
     },
     "events": {
      "$when": "bool(v(\"explosive\", false))",
      "on_hit": {
       "part": "drop"
      }
     }
    },
    "trail": {
     "$when": "bool(v(\"burn_trail\", false))",
     "delivery": "field",
     "origin": "parent",
     "geometry": {
      "type": "line",
      "length": 0.0,
      "width": "=float(v(\"spear_radius\", SPEAR_RADIUS)) * float(v(\"projectile_size_multiplier\", 1.0)) * 2.0",
      "pad": 0.0
     },
     "timing": {
      "duration": "=1.5 + float(v(\"burn_duration\", 1.5))",
      "interval": "=float(v(\"burn_tick\", 0.5))",
      "per_target": true
     },
     "payload": [
      {
       "$damage": "trail"
      }
     ],
     "limits": {
      "cap": 3
     },
     "vfx": {
      "style": "smoulder"
     }
    },
    "drop": {
     "$when": "bool(v(\"explosive\", false))",
     "delivery": "field",
     "origin": "parent",
