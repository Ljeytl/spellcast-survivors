      "radius": 0.0
     },
     {
      "type": "fan",
      "count": "=maxi(1, pick(has(\"degrees_per_shard\"), int(round(float(v(\"cone_degrees\", 90.0)) / float(v(\"degrees_per_shard\", 1.0)))), int(v(\"shard_count\", 13))))",
      "spread": "=float(v(\"cone_degrees\", 90.0)) / maxf(1.0, maxi(1, pick(has(\"degrees_per_shard\"), int(round(float(v(\"cone_degrees\", 90.0)) / float(v(\"degrees_per_shard\", 1.0)))), int(v(\"shard_count\", 13)))) - 1.0)"
