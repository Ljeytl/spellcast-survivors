      "type": "body",
      "radius": "=float(v(\"spear_radius\", SPEAR_RADIUS)) * float(v(\"projectile_size_multiplier\", 1.0))",
      "pad": 0.0
     },
     "motion": [
      {
       "type": "straight",
       "speed": "=700.0 * speed",
       "range": "=700.0 * speed * 1.5"
      }
